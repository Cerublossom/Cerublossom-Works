<Window x:Class="service.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:service.ViewModels"
        mc:Ignorable="d"
        Title="СБР — Сервис бронирования ресурсов"
        Height="760" Width="1180" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <vm:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- Круглые кнопки как в макете -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="22"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhitePillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource DarkBg}">
        <!-- Фон: фотография зала с зелёным затемнением -->
        <Image Source="{Binding HeroImage, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CC07120D" Offset="0"/>
                    <GradientStop Color="#99183A2D" Offset="0.5"/>
                    <GradientStop Color="#E607120D" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,36">
                    <Grid Width="72" Height="72" Margin="0,0,22,0">
                        <Border BorderBrush="White" BorderThickness="4" CornerRadius="6"/>
                        <Canvas Width="72" Height="72">
                            <Path Fill="White" Data="M 34,52 L 54,32 L 60,38 L 40,58 Z"/>
                            <Path Fill="White" Data="M 56,30 L 62,24 L 68,30 L 62,36 Z"/>
                        </Canvas>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="СБР" FontSize="44" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Сервис бронирования ресурсов" FontSize="17" Foreground="#E6EFEA"/>
                    </StackPanel>
                </StackPanel>

                <!-- Вход / Регистрация -->
                <StackPanel x:Name="WelcomePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Button x:Name="LoginButton" Content="Вход" Width="180"
                            Style="{StaticResource WhitePillButton}" Click="LoginButton_Click"/>
                    <Button x:Name="RegisterButton" Content="Регистрация" Width="180" Margin="16,0,0,0"
                            Style="{StaticResource WhitePillButton}" Click="RegisterButton_Click"/>
                </StackPanel>

                <TextBlock MaxWidth="720" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" LineHeight="19" Foreground="#DCE7E1"
                           Text="Переговорные комнаты, техника и студии в одном календаре. Выберите свободное время, пригласите коллег и получите уведомление — расписание синхронизируется автоматически."/>

                <!-- Панель входа -->
                <Border x:Name="LoginPanel" Visibility="Collapsed" Background="#F7FAF8"
                        CornerRadius="14" Width="380" Margin="0,4,0,0">
                    <StackPanel Margin="26">
                        <TextBlock Text="Вход" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <TextBlock Text="Пользователь" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="UserComboBox" Height="38" Margin="0,0,0,16"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                        <Button Content="Войти" Height="40" FontSize="14" Click="DoLogin_Click"/>
                        <Button Content="Назад" Height="34" FontSize="12" Margin="0,8,0,0"
                                Background="Transparent" Foreground="{StaticResource TextMuted}" Click="BackButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Панель регистрации -->
                <Border x:Name="RegisterPanel" Visibility="Collapsed" Background="#F7FAF8"
                        CornerRadius="14" Width="380" Margin="0,4,0,0">
                    <StackPanel Margin="26">
                        <TextBlock Text="Регистрация" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="ФИО" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FullNameBox" Height="36" Margin="0,0,0,10"/>
                        <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmailBox" Height="36" Margin="0,0,0,10"/>
                        <TextBlock Text="Пароль" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,0,0,14"/>
                        <Button Content="Зарегистрироваться" Height="40" FontSize="14" Click="DoRegister_Click"/>
                        <Button Content="Назад" Height="34" FontSize="12" Margin="0,8,0,0"
                                Background="Transparent" Foreground="{StaticResource TextMuted}" Click="BackButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Нижняя навигационная полоса как в макете -->
            <Border Grid.Row="1" Background="#E6101A15">
                <Grid Margin="26,0">
                    <Grid Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border BorderBrush="#B3FFFFFF" BorderThickness="2" CornerRadius="3"/>
                        <Canvas Width="24" Height="24">
                            <Path Fill="#B3FFFFFF" Data="M 11,18 L 18,11 L 21,14 L 14,21 Z"/>
                            <Path Fill="#B3FFFFFF" Data="M 20,10 L 22,8 L 24,10 L 22,12 Z"/>
                        </Canvas>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Календарь" FontSize="12" Foreground="#B3FFFFFF" Margin="0,0,28,0"/>
                        <TextBlock Text="Люди" FontSize="12" Foreground="#B3FFFFFF" Margin="0,0,28,0"/>
                        <TextBlock Text="Уведомления" FontSize="12" Foreground="#B3FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
