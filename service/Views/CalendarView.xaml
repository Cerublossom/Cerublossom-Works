<UserControl x:Class="service.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:service.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:CalendarViewModel}">
    <UserControl.Resources>
        <vm:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <vm:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: панель управления и карточки ресурсов -->
        <Grid Grid.Column="0" Margin="28,18,14,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="14,10">
                    <DatePicker SelectedDate="{Binding SelectedDate}" VerticalAlignment="Center" Width="130"/>
                    <TextBlock Text="{Binding SelectedDate, StringFormat='dd MMMM yyyy'}" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Margin="12,0,20,0"/>
                    <Button Content="Новое бронирование" Command="{Binding NewBookingCommand}" Height="34"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Height="34" Margin="8,0,0,0"
                            Style="{StaticResource SoftButton}"/>
                    <TextBlock Text="Нажмите на свободное время, чтобы забронировать"
                               VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ResourceCalendars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="512"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="492" Margin="0,0,20,20" ClipToBounds="True"
                                    Style="{StaticResource Card}">
                                <StackPanel>
                                    <!-- Фото ресурса с подписями поверх, как на макете -->
                                    <Grid Height="180">
                                        <Border Background="{StaticResource AccentDark}"/>
                                        <Image Source="{Binding Resource.ImagePath, Converter={StaticResource ImagePathConverter}}"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#33000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="0.35"/>
                                                    <GradientStop Color="#AA000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <!-- Тип ресурса -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                                    HorizontalAlignment="Left" Margin="12">
                                            <Border Background="#E6FFFFFF" CornerRadius="5" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Resource.Type}" FontSize="10"
                                                           Foreground="{StaticResource AccentDark}" Margin="8,3"/>
                                            </Border>
                                            <Border Background="#4D000000" CornerRadius="5">
                                                <TextBlock Text="Доступен"
                                                           FontSize="10" Foreground="White" Margin="8,3"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Название ресурса -->
                                        <Border Background="#F2FFFFFF" CornerRadius="6" Margin="12"
                                                VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Resource.Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource TextDark}" Margin="10,5"/>
                                        </Border>
                                    </Grid>

                                    <!-- Слоты по 30 минут: «пилюли» с временем -->
                                    <ItemsControl ItemsSource="{Binding Slots}" Margin="14,12,10,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemWidth="64"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="32" Margin="0,0,6,6" CornerRadius="6"
                                                        Cursor="Hand" BorderThickness="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8EFEB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Start, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="11" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding UserName, StringFormat='Бронирует: {0}'}"
                                                                       Foreground="{StaticResource TextMuted}"/>
                                                        </StackPanel>
                                                    </Border.ToolTip>
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftClick" Command="{Binding BookCommand}"/>
                                                    </Border.InputBindings>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Правая колонка: календарь и активные приглашения -->
        <StackPanel Grid.Column="1" Margin="0,18,28,18">
            <Border Style="{StaticResource Card}">
                <StackPanel Margin="10">
                    <TextBlock Text="Календарь" FontSize="13" FontWeight="Bold" Margin="6,4,0,6"/>
                    <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" DisplayMode="Month"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel Margin="14">
                    <TextBlock Text="Активные приглашения" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding ActiveBookings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7F5" CornerRadius="8" Margin="0,0,0,8">
                                    <StackPanel Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource Accent}" CornerRadius="5">
                                                <TextBlock Margin="6,2" FontSize="10" Foreground="White">
                                                    <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"/>
                                                    <Run Text="–"/>
                                                    <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Resource.Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDark}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding User.DisplayName, StringFormat='Сотрудник: {0}'}"
                                                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="На этот день бронирований нет" FontSize="11"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Visibility="{Binding ActiveBookings.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
