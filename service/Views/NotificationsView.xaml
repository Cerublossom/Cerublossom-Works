<UserControl x:Class="service.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:service.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance vm:NotificationsViewModel}">
    <Grid Background="{StaticResource PageBg}">
        <Border Style="{StaticResource Card}" Margin="28,18">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Уведомления и синхронизация с календарем"
                           Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedUser}" Width="240" Height="32" Margin="0,0,12,0"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Width="100" Height="32"
                            Style="{StaticResource SoftButton}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding UnreadCount, StringFormat='Непрочитано: {0}'}"
                               VerticalAlignment="Center" Foreground="{StaticResource AccentDark}" FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F9F7" CornerRadius="8" Margin="0,3" BorderThickness="0">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Content="Прочитано" IsChecked="{Binding IsRead, Mode=TwoWay}"
                                              Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   FontSize="12" Foreground="{StaticResource TextDark}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding UserName}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,8,0"/>
                                            <TextBlock Text="•" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Accent}"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Прочитано" Command="{Binding MarkReadCommand}"
                                            CommandParameter="{Binding Id}" Height="28" Width="110" FontSize="10"
                                            Style="{StaticResource SoftButton}" Margin="10,0,0,0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
