<UserControl x:Class="service.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:service.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:BookingViewModel}">
    <Grid Background="{StaticResource PageBg}">
        <Border Style="{StaticResource Card}" Margin="28,18" VerticalAlignment="Top"
                HorizontalAlignment="Left" Width="820">
            <StackPanel Margin="24">
                <TextBlock Text="Создание бронирования" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
                <TextBlock Text="Выберите ресурс, дату и время. В поле «Кем бронируется» можно указать любого сотрудника."
                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ресурс:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Resources}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedResource}" VerticalAlignment="Center" Margin="0,0,16,10" Height="32"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Кем бронируется:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedUser}" VerticalAlignment="Center" Margin="0,0,0,10" Height="32"
                              ToolTip="Сотрудник, на которого оформляется бронирование"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding SelectedDate}"
                                VerticalAlignment="Center" Margin="0,0,16,10" Height="32"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Время:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding StartTime}" Width="88" Height="32" Margin="0,0,6,0"/>
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
                        <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding EndTime}" Width="88" Height="32"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Цель:" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Purpose}"
                             VerticalAlignment="Center" Margin="0,0,0,10" Height="32"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}"
                               Foreground="{StaticResource AccentDark}" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Сохранить бронирование" Command="{Binding SaveCommand}" Height="38" Padding="22,0"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Height="38" Padding="22,0"
                            Margin="10,0,0,0" Style="{StaticResource SoftButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
