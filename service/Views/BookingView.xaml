<UserControl x:Class="service.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/2006/xaml"
             xmlns:vm="clr-namespace:service.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance vm:BookingViewModel}">
    <Grid Background="{StaticResource PanelBg}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание бронирования ресурса" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ресурс:" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Resources}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedResource}" VerticalAlignment="Center" Margin="0,0,16,8"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Сотрудник:" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedUser}" VerticalAlignment="Center" Margin="0,0,16,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата:" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding SelectedDate}" VerticalAlignment="Center" Margin="0,0,16,8"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Время:" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding StartTime}" Width="80" Margin="0,0,4,0"/>
                <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding EndTime}" Width="80"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Цель:" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Purpose}" VerticalAlignment="Center"
                     Margin="0,0,16,8" MinWidth="300"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Сохранить бронирование" Command="{Binding SaveCommand}" Width="210"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="12,0,0,0" Background="#666" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#FFA0A0" TextWrapping="Wrap"
                   MaxWidth="700"/>
    </Grid>
</UserControl>
