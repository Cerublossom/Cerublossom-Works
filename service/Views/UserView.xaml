<UserControl x:Class="service.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:service.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:UserViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <vm:ImagePathConverter x:Key="ImagePathConverter"/>
        <vm:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель: поиск, сортировка, добавление -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="28,18,14,16">
            <Grid Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#F5F7F5" CornerRadius="8" Height="34" Width="300"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Поиск" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 FontSize="12" Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"
                          Width="150" Height="34" Margin="10,0,0,0" VerticalContentAlignment="Center"/>

                <Button Grid.Column="3" Content="Добавить" Command="{Binding NewCommand}" Height="34"
                        Padding="20,0"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentDark}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,8,0,0"/>
            </Grid>
        </Border>

        <!-- Карточки людей -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="28,0,14,18"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Users}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,16,14" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото пользователя, под ним инициалы на случай,
                                     если картинка не загрузилась -->
                                <Border Grid.Column="0" Width="104" Height="96" CornerRadius="8"
                                        Background="{StaticResource AccentDark}">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="Bold"
                                                   Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image Source="{Binding AvatarUrl, Converter={StaticResource ImagePathConverter}}"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Email}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="4"
                                            HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Role}" FontSize="10"
                                                   Foreground="{StaticResource AccentSoftText}" Margin="7,2"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Изменить" Height="30" FontSize="11" Padding="16,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Удалить" Height="30" FontSize="11" Padding="16,0"
                                                Margin="8,0,0,0" Style="{StaticResource SoftButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Правая колонка: календарь и активные приглашения -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,18,28,18">
            <Border Style="{StaticResource Card}">
                <StackPanel Margin="10">
                    <TextBlock Text="Календарь" FontSize="13" FontWeight="Bold" Margin="6,4,0,6"/>
                    <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" DisplayMode="Month"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel Margin="14">
                    <TextBlock Text="Активные приглашения" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding DayBookings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7F5" CornerRadius="8" Margin="0,0,0,8">
                                    <StackPanel Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource Accent}" CornerRadius="5">
                                                <TextBlock Margin="6,2" FontSize="10" Foreground="White">
                                                    <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"/>
                                                    <Run Text="–"/>
                                                    <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Resource.Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDark}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding User.DisplayName, StringFormat='Сотрудник: {0}'}"
                                                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="На этот день бронирований нет" FontSize="11"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Visibility="{Binding DayBookings.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Форма редактирования поверх страницы -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <Border Background="White" CornerRadius="12" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="24">
                    <TextBlock Text="Карточка пользователя" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                    <TextBlock Text="ФИО" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="Роль" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Height="34" Margin="0,0,0,10"/>

                    <CheckBox Content="Пользователь активен" IsChecked="{Binding IsActive}" Margin="0,4,0,0"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentDark}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Сохранить" Width="120" Height="36"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="Отмена" Width="110" Height="36" Margin="10,0,0,0"
                                Style="{StaticResource SoftButton}"
                                Command="{Binding CancelEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
