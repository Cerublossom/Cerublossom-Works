<Window x:Class="service.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:service.ViewModels"
        mc:Ignorable="d"
        Title="СБР — Сервис бронирования ресурсов"
        Height="860" Width="1400" MinHeight="720" MinWidth="1180"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <vm:ImagePathConverter x:Key="ImagePathConverter"/>
        <LinearGradientBrush x:Key="HeroOverlay" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D908120E" Offset="0"/>
            <GradientStop Color="#B3122520" Offset="0.55"/>
            <GradientStop Color="#E60B1511" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка как в макете: фотография зала с затемнением,
             под ней тёмная полоса навигации -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Background="{StaticResource DarkBg}"/>
                <Image Source="{Binding HeaderImage, Converter={StaticResource ImagePathConverter}}"
                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Rectangle Fill="{StaticResource HeroOverlay}"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                    <TextBlock Text="Сервис бронирования общих ресурсов"
                               FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Переговорные комнаты, техника и студии в одном календаре. Выберите свободное время, пригласите коллег и не беспокойтесь о накладках."
                               FontSize="11" Foreground="#E9F1EC" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"/>
                </StackPanel>
            </Grid>

            <!-- Навигационная полоса -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBg}">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Логотип: квадрат с карандашом -->
                        <Grid Width="26" Height="26" Margin="0,0,12,0">
                            <Border BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                            <Canvas Width="26" Height="26">
                                <Path Fill="White" Data="M 12,19 L 20,11 L 23,14 L 15,22 Z"/>
                                <Path Fill="White" Data="M 21,10 L 23,8 L 26,11 L 24,13 Z"/>
                            </Canvas>
                        </Grid>
                        <TextBlock Text="СБР" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextLight}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Календарь" Style="{StaticResource NavButton}" Command="{Binding ShowCalendarCommand}"/>
                        <Button Content="Бронирование" Style="{StaticResource NavButton}" Command="{Binding ShowBookingCommand}"/>
                        <Button Content="Ресурсы" Style="{StaticResource NavButton}" Command="{Binding ShowResourcesCommand}"/>
                        <Button Content="Люди" Style="{StaticResource NavButton}" Command="{Binding ShowUsersCommand}"/>
                        <Button Content="Уведомления" Style="{StaticResource NavButton}" Command="{Binding ShowNotificationsCommand}"/>

                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Accent}" Margin="16,0,8,0">
                            <TextBlock Text="{Binding CurrentUser.Initials}" FontSize="10" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="12"
                                   Foreground="#E9F1EC" VerticalAlignment="Center" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Рабочая область: светлая, как на макете -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Background="{StaticResource PageBg}"/>
    </Grid>
</Window>
