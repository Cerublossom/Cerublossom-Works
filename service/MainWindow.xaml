<Window x:Class="service.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:service"
        mc:Ignorable="d"
        Title="Сервис бронирования общих ресурсов"
        Height="768" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource WindowBg}" Padding="16,24,16,16">
            <StackPanel>
                <TextBlock Text="БРОНИРОВАНИЕ РЕСУРСОВ" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,0,28"/>

                <Button Content="Календарь ресурсов" Command="{Binding ShowCalendarCommand}" Width="210" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Button Content="Создать бронирование" Command="{Binding ShowBookingCommand}" Width="210" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Button Content="Управление ресурсами" Command="{Binding ShowResourcesCommand}" Width="210" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Button Content="Уведомления" Command="{Binding ShowNotificationsCommand}" Width="210" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Button Content="Пользователи" Command="{Binding ShowUsersCommand}" Width="210" Margin="0,0,0,24" HorizontalAlignment="Left"/>

                <Border BorderBrush="#444" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                <TextBlock Text="Пользователь:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextLight}"/>
                <TextBlock Text="{Binding CurrentUser.Email}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16" Background="{StaticResource PanelBg}"/>
    </Grid>
</Window>
